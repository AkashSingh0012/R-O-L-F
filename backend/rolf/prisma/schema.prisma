generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expires   DateTime

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        Int      @id @default(autoincrement())
  sheetId   Int
  userId    String
  cellRef   String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  // ✅ Added proper relations
  Sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  User  User  @relation(fields: [userId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Session         Session[]
  Sheet           Sheet[]
  SheetData       SheetData[]
  SheetPermission SheetPermission[]
  SheetVersion    SheetVersion[]
  AuditLog        AuditLog[]
  Comment         Comment[]         // ✅ added
}

model Sheet {
  id        Int      @id @default(autoincrement())
  name      String
  createdBy String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User            User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  SheetData       SheetData?
  SheetPermission SheetPermission[]
  AuditLog        AuditLog[]
  SheetVersion    SheetVersion[]
  Comment         Comment[]         // ✅ added
}

model SheetVersion {
  id        Int      @id @default(autoincrement())
  sheetId   Int
  version   Int
  data      Json
  savedBy   String
  createdAt DateTime @default(now())

  Sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  User  User  @relation(fields: [savedBy], references: [id])

  @@unique([sheetId, version])
}

model SheetData {
  id        Int      @id @default(autoincrement())
  sheetId   Int      @unique
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  Sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  User  User? @relation(fields: [updatedBy], references: [id])
}

model SheetPermission {
  id      Int       @id @default(autoincrement())
  sheetId Int
  userId  String
  role    SheetRole

  Sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  User  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sheetId, userId])
}

model AuditLog {
  id        Int        @id @default(autoincrement())
  sheetId   Int?                          // ← nullable
  userId    String
  action    ActionType
  details   Json
  createdAt DateTime   @default(now())
  Sheet Sheet? @relation(fields: [sheetId], references: [id], onDelete: SetNull)  // ← SetNull
  User  User  @relation(fields: [userId], references: [id])
}

enum ActionType {
  ADDED
  DELETED
  UPDATED
  ROLLED_BACK
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum SheetRole {
  OWNER
  EDITOR
  VIEWER
}